GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Datos publicos disponibles en Supabase > Project Settings > API Keys
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Clave privada: solo debe existir en el servidor, nunca en el navegador
SUPABASE_SECRET_KEY=

# MercadoPago (Tus integraciones > Credenciales). Usá primero las credenciales de prueba.
MP_ACCESS_TOKEN=
# Clave secreta de Webhooks (Tus integraciones > Webhooks) para validar la firma de las notificaciones
MP_WEBHOOK_SECRET=
# URL pública del sitio, sin barra final (ej: https://tu-sitio.vercel.app)
PUBLIC_SITE_URL=
PREMIUM_PRICE_ARS=9999
PREMIUM_DAILY_READINGS=3
